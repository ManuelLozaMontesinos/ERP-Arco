@{
    ViewData["Title"] = "Tablero Principal";
    string cid = ViewBag.cid;
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark font-weight-bold">
                    <i class="fas fa-tachometer-alt text-primary mr-2"></i>Tablero de Control
                </h1>
                <small class="text-muted">SIGANET ERP - Visión General y Accesos Rápidos</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'home/index' });">Inicio</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
                <div class="mt-2 text-right">
                    <span class="badge badge-primary px-2 py-1 mr-1"><i class="fas fa-building mr-1"></i>@ViewBag.Empresa</span>
                    <span class="badge badge-info px-2 py-1 mr-1"><i class="fas fa-map-marker-alt mr-1"></i>@ViewBag.Sede</span>
                    <span class="badge badge-secondary px-2 py-1"><i class="fas fa-calendar-alt mr-1"></i>Periodo: @ViewBag.Periodo</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- 1. FILA DE TARJETAS KPI (AdminLTE v3 Small-Boxes con navegación SPA) -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info shadow-sm">
                    <div class="inner">
                        <h3 id="kpi-ventas">S/ 384,920</h3>
                        <p>Facturación del Mes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });" class="small-box-footer">
                        Ver Comprobantes <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success shadow-sm">
                    <div class="inner">
                        <h3 id="kpi-cotizaciones">1,428</h3>
                        <p>Cotizaciones Activas</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });" class="small-box-footer">
                        Ver Cotizaciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning shadow-sm">
                    <div class="inner">
                        <h3 id="kpi-produccion">186</h3>
                        <p>Órdenes de Producción</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-industry"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });" class="small-box-footer">
                        Ver Planta / O.P. <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger shadow-sm">
                    <div class="inner">
                        <h3 id="kpi-productos">4,918</h3>
                        <p>Productos en Catálogo</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });" class="small-box-footer">
                        Ver Catálogo <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. SECCIÓN PRINCIPAL (Gráficos y Tablas) -->
        <div class="row">

            <!-- Columna Izquierda (7 columnas) -->
            <div class="col-lg-7">

                <!-- Gráfico de Ventas -->
                <div class="card card-primary card-outline shadow-sm">
                    <div class="card-header border-0">
                        <div class="d-flex justify-content-between">
                            <h3 class="card-title font-weight-bold">
                                <i class="fas fa-chart-line text-primary mr-1"></i> Evolución de Ventas (Miles de Soles)
                            </h3>
                            <span class="badge badge-success"><i class="fas fa-arrow-up mr-1"></i>+12.4% vs año ant.</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="position-relative mb-2">
                            <canvas id="salesChart" height="220"></canvas>
                        </div>
                        <div class="d-flex flex-row justify-content-end">
                            <span class="mr-3 text-muted">
                                <i class="fas fa-square text-primary"></i> Año Actual (2026)
                            </span>
                            <span class="text-muted">
                                <i class="fas fa-square text-gray"></i> Año Anterior (2025)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Últimos Comprobantes -->
                <div class="card card-outline card-info shadow-sm">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold">
                            <i class="fas fa-file-invoice text-info mr-1"></i> Últimos Comprobantes Emitidos
                        </h3>
                        <div class="card-tools">
                            <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });" class="btn btn-tool btn-sm">
                                <i class="fas fa-external-link-alt"></i> Ver todos
                            </a>
                        </div>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>Tipo / Nro</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th class="text-right">Monto</th>
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-comprobantes-body">
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        <i class="fas fa-spinner fa-spin mr-2"></i> Cargando comprobantes...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- Columna Derecha (5 columnas) -->
            <div class="col-lg-5">

                <!-- Accesos Rápidos con $(this).getView() -->
                <div class="card card-success card-outline shadow-sm">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold">
                            <i class="fas fa-bolt text-success mr-1"></i> Accesos Rápidos
                        </h3>
                    </div>
                    <div class="card-body text-center p-2">
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });">
                            <i class="fas fa-file-signature text-success"></i> Cotizaciones
                        </a>
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });">
                            <i class="fas fa-dolly text-warning"></i> Pedidos
                        </a>
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });">
                            <i class="fas fa-receipt text-primary"></i> Facturar
                        </a>
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });">
                            <i class="fas fa-industry text-danger"></i> Producción
                        </a>
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'almacen/index' });">
                            <i class="fas fa-warehouse text-info"></i> Almacenes
                        </a>
                        <a class="btn btn-app shadow-sm m-1" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });">
                            <i class="fas fa-tags text-secondary"></i> Productos
                        </a>
                    </div>
                </div>

                <!-- Gráfico de Producción en Planta -->
                <div class="card card-warning card-outline shadow-sm">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold">
                            <i class="fas fa-chart-pie text-warning mr-1"></i> Estado de Producción
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="productionChart" height="200"></canvas>
                    </div>
                </div>

                <!-- Tarjeta informativa de Entorno -->
                <div class="info-box bg-light shadow-sm">
                    <span class="info-box-icon bg-success"><i class="fas fa-server"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text font-weight-bold">Entorno de Desarrollo Activo</span>
                        <span class="info-box-number text-muted font-weight-normal">
                            Base de Datos: <code>esderp_v6</code> (Localhost)
                        </span>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                        <span class="progress-description text-muted">
                            <i class="fas fa-shield-alt text-success mr-1"></i> Ambiente 100% seguro y aislado
                        </span>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>

<!-- Chart.js local -->
<script src="~/plugins/chart.js/chart.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        var cid = $('#__cid').val() || '@cid';

        // 1. Cargar datos del Dashboard mediante AJAX
        $.ajax({
            url: '@Url.Action("ObtenerDatosDashboard", "Home")',
            type: 'GET',
            data: { cid: cid },
            headers: { 'x-app-cid': cid },
            success: function (res) {
                if (res && res.success) {

                    // Cargar KPIs
                    if (res.kpis) {
                        $('#kpi-ventas').text(res.kpis.ventasMes);
                        $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                        $('#kpi-produccion').text(res.kpis.ordenesProduccion);
                        $('#kpi-productos').text(res.kpis.productosCatalogo);
                    }

                    // Renderizar tabla de ultimos comprobantes
                    var tbody = $('#tabla-comprobantes-body');
                    tbody.empty();

                    if (res.ultimosComprobantes && res.ultimosComprobantes.length > 0) {
                        $.each(res.ultimosComprobantes, function (i, c) {
                            var badgeClass = 'badge-success';
                            if (c.tipo === 'BOL') badgeClass = 'badge-info';
                            if (c.tipo === 'NC') badgeClass = 'badge-danger';

                            var row = '<tr>' +
                                '<td><span class="badge ' + badgeClass + ' mr-1">' + c.tipo + '</span>' + c.serieNumero + '</td>' +
                                '<td><small class="font-weight-bold">' + c.cliente + '</small></td>' +
                                '<td><small class="text-muted">' + c.fecha + '</small></td>' +
                                '<td class="text-right font-weight-bold">' + c.moneda + ' ' + c.monto + '</td>' +
                                '<td class="text-center"><span class="badge badge-light border">' + c.estado + '</span></td>' +
                                '</tr>';
                            tbody.append(row);
                        });
                    } else {
                        tbody.html('<tr><td colspan="5" class="text-center text-muted py-3">No se encontraron comprobantes recientes</td></tr>');
                    }

                    // 2. Gráfico de Ventas
                    if (res.graficoVentas) {
                        var ctxSales = document.getElementById('salesChart').getContext('2d');
                        new Chart(ctxSales, {
                            type: 'bar',
                            data: {
                                labels: res.graficoVentas.meses,
                                datasets: [
                                    {
                                        label: '2026',
                                        backgroundColor: '#007bff',
                                        borderColor: '#007bff',
                                        data: res.graficoVentas.ventas2026,
                                        borderRadius: 4
                                    },
                                    {
                                        label: '2025',
                                        backgroundColor: '#ced4da',
                                        borderColor: '#ced4da',
                                        data: res.graficoVentas.ventas2025,
                                        borderRadius: 4
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            callback: function(value) { return 'S/ ' + value + 'k'; }
                                        }
                                    }
                                }
                            }
                        });
                    }

                    // 3. Gráfico de Producción
                    if (res.graficoProduccion) {
                        var ctxProd = document.getElementById('productionChart').getContext('2d');
                        new Chart(ctxProd, {
                            type: 'doughnut',
                            data: {
                                labels: res.graficoProduccion.labels,
                                datasets: [{
                                    data: res.graficoProduccion.valores,
                                    backgroundColor: ['#17a2b8', '#28a745', '#ffc107', '#dc3545']
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'bottom'
                                    }
                                }
                            }
                        });
                    }

                }
            },
            error: function () {
                $('#tabla-comprobantes-body').html('<tr><td colspan="5" class="text-center text-muted py-3">Panel cargado en modo sin conexión</td></tr>');
            }
        });
    });
</script>
